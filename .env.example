# Upgrading from the old DM Keith? The variable names changed. Start from this
# file rather than editing your existing .env -- OPENAI_API_KEY, DMK_DEFAULT_MODE,
# DMK_PROFANITY_LEVEL, DMK_RATING, DMK_TANGENTS_LEVEL and DMK_ACHIEVEMENT_DENSITY
# are all gone, and DMK_MODEL now needs a "provider:model" prefix.

# --- Required ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Model selection --------------------------------------------------------
# Format is "provider:model" -- a bare "gpt-4o" is rejected at startup.
# Swap providers by changing this one line; the same campaign continues
# regardless of which model is running it.
#   anthropic:claude-opus-5      openai:gpt-5
#   deepseek:deepseek-chat       ollama:qwen3:14b
DMK_MODEL=anthropic:claude-opus-5

# Cheap model used only to compress old transcript into the rolling campaign
# summary. Not used yet -- the summariser lands in milestone 3.
DMK_SUMMARY_MODEL=anthropic:claude-haiku-4-5

# --- Provider credentials ---------------------------------------------------
# Only the one matching DMK_MODEL needs a value.
# These are read directly by pydantic-ai, never by DM Keith's own code.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# For local models served by Ollama, e.g. http://bossbitch.local:11434/v1
OLLAMA_BASE_URL=

# --- Storage ----------------------------------------------------------------
# DOCKER: set DMK_DB_DIR only. It's the directory on the host where the campaign
# database is kept, and compose mounts it at /data inside the container. Absolute
# or relative both work.
#   DMK_DB_DIR=/mnt/sata/dmk/db      ->  database at /mnt/sata/dmk/db/main.sqlite3
DMK_DB_DIR=./local

# Leave DMK_DB_PATH unset under Docker -- the image already points it at the
# mounted directory (/data/main.sqlite3). Pointing it anywhere else writes inside
# the container, where the data is lost on the next rebuild, so the bot refuses to
# start if you do. Set it only for local runs outside Docker:
# DMK_DB_PATH=./local/dmk.sqlite3

# Docker only: run the container as the host user that owns DMK_DB_DIR,
# otherwise SQLite can't write to the mount. Check with `id -u` / `id -g`.
DMK_UID=1000
DMK_GID=1000

# --- Runtime ----------------------------------------------------------------
DMK_LOG_LEVEL=INFO
