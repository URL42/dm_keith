# --- Required ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Model selection --------------------------------------------------------
# Format is "provider:model". Swap providers by changing this one line; the same
# campaign continues regardless of which model is running it.
#   anthropic:claude-opus-5      openai:gpt-5
#   deepseek:deepseek-chat       ollama:qwen3:14b
DMK_MODEL=anthropic:claude-opus-5

# Cheap model used only to compress old transcript into the rolling campaign summary.
DMK_SUMMARY_MODEL=anthropic:claude-haiku-4-5

# --- Provider credentials ---------------------------------------------------
# Only the one matching DMK_MODEL (and DMK_SUMMARY_MODEL) needs a value.
# These are read directly by pydantic-ai, never by DM Keith's own code.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# For local models served by Ollama, e.g. http://bossbitch.local:11434/v1
OLLAMA_BASE_URL=

# --- Runtime ----------------------------------------------------------------
DMK_DB_PATH=./local/dmk.sqlite3
DMK_LOG_LEVEL=INFO
